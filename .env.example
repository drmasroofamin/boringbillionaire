# Copy to backend/.env. Never commit real configuration or credentials.
DEMO_MODE=true
DATABASE_URL=sqlite:///./boring.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
S3_BUCKET=
AWS_REGION=ap-south-1
# Reserved for your approved Payoneer partner integration, not a personal account login.
# These fields DO NOT enable live mode; see docs/PAYONEER.md.
PAYONEER_ENVIRONMENT=sandbox
PAYONEER_CLIENT_ID=
PAYONEER_CLIENT_SECRET=
PAYONEER_PROGRAM_ID=
